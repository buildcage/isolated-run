#!/command/with-contenv sh
set -e

echo "init-haproxy-cfg: generating HAProxy configuration..."

PROXY_MODE=${PROXY_MODE:-"restrict"}
ALLOWED_HTTPS_RULES=${ALLOWED_HTTPS_RULES:-""}
ALLOWED_HTTP_RULES=${ALLOWED_HTTP_RULES:-""}
ALLOWED_IP_RULES=${ALLOWED_IP_RULES:-""}

echo "Proxy mode: $PROXY_MODE"
echo "Allowed HTTPS rules: $ALLOWED_HTTPS_RULES"
echo "Allowed HTTP rules: $ALLOWED_HTTP_RULES"
echo "Allowed IP rules: $ALLOWED_IP_RULES"

mkdir -p /etc/haproxy/rules
echo "Converting rules to regex..."
if [ "$PROXY_MODE" = "audit" ]; then
    echo ".*" > /etc/haproxy/rules/allowed_https.lst
    echo ".*" > /etc/haproxy/rules/allowed_http.lst
    echo ".*" > /etc/haproxy/rules/allowed_ips.lst
else
    echo "$ALLOWED_HTTPS_RULES" | qjs --std -m /opt/buildcage/scripts/convert-rule.js > /etc/haproxy/rules/allowed_https.lst
    echo "$ALLOWED_HTTP_RULES"  | qjs --std -m /opt/buildcage/scripts/convert-rule.js > /etc/haproxy/rules/allowed_http.lst
    echo "$ALLOWED_IP_RULES"    | qjs --std -m /opt/buildcage/scripts/convert-rule.js > /etc/haproxy/rules/allowed_ips.lst
fi

# Addresses the runner itself holds, refused as a resolved destination by the
# template's internal-address acl. HOST_ADDRESSES is what the action read off
# the runner; the routing table adds the compose network's gateway, a runner
# address the action could not see yet. A file because HAProxy silently
# truncates an acl line past MAX_LINE_ARGS.
{
    for addr in $HOST_ADDRESSES; do echo "$addr"; done
    ip -4 route show | awk '{ for (i = 1; i < NF; i++) if ($i == "via") print $(i + 1) }'
} | sort -u > /etc/haproxy/rules/host_addrs.lst
echo "Guarded runner addresses: $(tr '\n' ' ' < /etc/haproxy/rules/host_addrs.lst)"

# Only the integration tests name an upstream, as IPv4 addresses separated by
# commas or spaces. When unset/empty, fall back to the container's own
# /etc/resolv.conf via HAProxy's parse-resolv-conf instead of hardcoding a
# specific resolver.
if [ -z "$EXTERNAL_RESOLVER" ]; then
    echo "Resolver: (default, via /etc/resolv.conf)"
    HAPROXY_NAMESERVERS="
    parse-resolv-conf"
else
    echo "Resolver: $EXTERNAL_RESOLVER"
    HAPROXY_NAMESERVERS=""
    RESOLVER_IDX=1
    for ip in $(echo "$EXTERNAL_RESOLVER" | tr ',' ' '); do
        # Each entry is substituted into haproxy.cfg verbatim, so a value
        # that is not an address is refused here rather than left to open a
        # directive of its own in that file.
        if ! echo "$ip" | grep -Eq '^[0-9]{1,3}(\.[0-9]{1,3}){3}$'; then
            echo "init-haproxy-cfg: EXTERNAL_RESOLVER takes IPv4 addresses; \"$ip\" is not one" >&2
            exit 1
        fi
        HAPROXY_NAMESERVERS="${HAPROXY_NAMESERVERS}
    nameserver ns${RESOLVER_IDX} ${ip}:53"
        RESOLVER_IDX=$((RESOLVER_IDX + 1))
    done
fi

if [ "$PROXY_MODE" = "audit" ]; then
    HAPROXY_DECISION_LABEL="AUDIT"
    HAPROXY_AUDIT_ACCEPT="tcp-request content accept if !is_dns_routed !is_ip_match"
else
    HAPROXY_DECISION_LABEL="ALLOWED"
    HAPROXY_AUDIT_ACCEPT="# restrict mode: reject unmatched IPs below"
fi

export HAPROXY_NAMESERVERS HAPROXY_DECISION_LABEL HAPROXY_AUDIT_ACCEPT

echo "Generating haproxy.cfg from template..."
envsubst '${HAPROXY_NAMESERVERS} ${HAPROXY_DECISION_LABEL} ${HAPROXY_AUDIT_ACCEPT}' \
  < /etc/haproxy/haproxy.cfg.template \
  > /etc/haproxy/haproxy.cfg

# The Corefile CoreDNS reads at startup (its s6 unit depends on this oneshot).
# 172.20.0.1 is the proxy gateway every name resolves to. The raw rule strings
# are passed, not the .lst regexes above: gen-coredns compiles them through the
# same path the HAProxy allowlist comes from, so what CoreDNS logs as allowed
# cannot drift from what HAProxy lets through. In audit mode the rules are
# ignored, every name logged as allowed.
echo "Generating CoreDNS Corefile..."
qjs --std -m /opt/buildcage/scripts/gen-coredns.js \
  /etc/coredns/Corefile \
  172.20.0.1 \
  "$PROXY_MODE" \
  "$ALLOWED_HTTPS_RULES" \
  "$ALLOWED_HTTP_RULES"

echo "init-haproxy-cfg: configuration generated"
