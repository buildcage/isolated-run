#!/command/with-contenv sh
exec 2>&1
# Guaranteed non-decision line, so report can tell "haproxy logged nothing"
# apart from "haproxy never started". Carries a millisecond epoch so the
# report can show every other line's time relative to this moment; qjs
# rather than `date`, because BusyBox's `date` has no sub-second precision.
echo "buildcage haproxy starting $(qjs -e 'console.log(Date.now())')"
# With one thread (nbthread 1), a line is dropped only once the pipe to s6-log
# is full, which a stalled s6-log fills within seconds at the default 64KB.
# pipesz warns and carries on if it cannot resize; a dropped line is still
# counted either way.
exec pipesz -o -s 1048576 -- \
  s6-notifyoncheck -d -w 250 -n 12 haproxy -f /etc/haproxy/haproxy.cfg -db
